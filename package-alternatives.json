{
  "name": "gcp-outages-dashboard-alternatives",
  "version": "1.0.0",
  "description": "Alternative package manager configurations",
  "packageManager": "pnpm@8.0.0",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0",
    "yarn": ">=1.22.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t outage-dashboard .",
    "docker:run": "docker run -p 3000:3000 outage-dashboard",
    "docker:compose": "docker-compose up --build",
    "install:yarn": "yarn install",
    "install:pnpm": "pnpm install",
    "install:bun": "bun install"
  },
  "volta": {
    "node": "18.18.0",
    "yarn": "1.22.19"
  }
}
